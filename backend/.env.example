# Copy to .env and export (or `set -a; source .env; set +a`) before running uvicorn.
ROOM3D_DATA_DIR=./storage
ROOM3D_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ROOM3D_WORKER_TOKEN=change-me-shared-secret-with-the-kaggle-worker
# Auth is a bonus in the brief: set false to run every request as a built-in demo user.
ROOM3D_AUTH_REQUIRED=true
ROOM3D_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ROOM3D_MAX_VIDEO_MB=600
ROOM3D_STALE_SECONDS=600
ROOM3D_MAX_ATTEMPTS=2
ROOM3D_KEEP_DELIVERY_ZIP=false
